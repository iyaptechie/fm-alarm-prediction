{
  "name": "FM Alarm Prediction",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bullseye",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "pip install -r requirements.txt && echo 'Setup complete. Copy .env.example to .env and fill in your API keys.'",

  "forwardPorts": [7474, 7687, 8000, 8501],
  "portsAttributes": {
    "7474": { "label": "Neo4j Browser", "onAutoForward": "notify" },
    "7687": { "label": "Neo4j Bolt",    "onAutoForward": "silent" },
    "8000": { "label": "FastAPI",        "onAutoForward": "notify" },
    "8501": { "label": "Streamlit",      "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "ms-python.black-formatter" }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "redhat.vscode-yaml",
        "donjayamanne.githistory"
      ]
    }
  },

  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}"
  }
}
